{
  "name": "jmetrix",
  "version": "1.0.0",
  "description": "JMETRIX — Plataforma Inteligente de Testes de Performance. Test. Measure. Dominate.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "start:backend": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "start:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "test:junit": "run-junit.bat",
    "setup": "powershell -ExecutionPolicy Bypass -File ./setup.ps1",
    "pack:win": "electron-packager . JMETRIX --platform=win32 --arch=x64 --out=dist-electron --overwrite --prune=false --no-asar --icon=electron/icon.ico",
    "build:app": "npm run build:frontend && npm run pack:win",
    "dist:installer": "npm run build:frontend && electron-builder --win"
  },
  "build": {
    "appId": "com.jmetrix.app",
    "productName": "JMETRIX",
    "asar": false,
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JMETRIX",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "artifactName": "JMETRIX-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "jmetrix",
    "performance-testing",
    "jmeter",
    "vue3",
    "echarts",
    "load-testing",
    "electron"
  ],
  "author": "JMETRIX Team",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
